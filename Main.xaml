          <ui:InvokeCode ContinueOnError="{x:Null}" Code="'Declare variables&#xA;Dim str_moversHTML As String = &quot;&lt;span style=&quot;&quot;font-size:13px;color:#7a8fa6;font-style:italic;&quot;&quot;&gt;No significant movers today.&lt;/span&gt;&quot;&#xA;Dim str_tableHTML As String = &quot;&quot;&#xA;Dim movers As List(Of String) = New List(Of String)&#xA;Dim tickers As List(Of String) = New List(Of String)&#xA;&#xA;For Each row As Datarow In in_dtOutput.Rows&#xA;    'Add to movers section when the threshold breached | add all elements to tickers&#xA;&#x9;If CDbl(row(&quot;PercentChange&quot;).ToString.Replace(&quot;%&quot;,&quot;&quot;).Replace(&quot;+&quot;,&quot;&quot;).Trim) &gt;= in_threshold&#xA;&#x9;&#x9;movers.Add(&quot;&lt;span style=&quot;&quot;display:inline-block;padding:4px 10px;border-radius:4px;font-size:13px;font-weight:600;margin:3px 4px 3px 0;background-color:#e6f4ea;color:#1e7e34;&quot;&quot;&gt;&quot;+row(&quot;Ticker&quot;).ToString+&quot; &quot;+row(&quot;PercentChange&quot;).ToString+&quot;&lt;/span&gt;&quot;)&#xA;&#x9;&#x9;tickers.Add(&quot;&lt;tr&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  &lt;td style=&quot;&quot;padding:9px 12px;border-bottom:1px solid #f0f2f5;color:#2c3e50;&quot;&quot;&gt;&quot;+row(&quot;Ticker&quot;).ToString+&quot;&lt;/td&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  &lt;td style=&quot;&quot;padding:9px 12px;border-bottom:1px solid #f0f2f5;color:#2c3e50;&quot;&quot;&gt;&quot;+row(&quot;Open&quot;).ToString+&quot;&lt;/td&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  &lt;td style=&quot;&quot;padding:9px 12px;border-bottom:1px solid #f0f2f5;color:#2c3e50;&quot;&quot;&gt;&quot;+row(&quot;Close&quot;).ToString+&quot;&lt;/td&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  &lt;td style=&quot;&quot;padding:9px 12px;border-bottom:1px solid #f0f2f5;font-weight:600;color:#1e7e34;&quot;&quot;&gt;&quot;+row(&quot;PercentChange&quot;).ToString+&quot;&lt;/td&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  &lt;td style=&quot;&quot;padding:9px 12px;border-bottom:1px solid #f0f2f5;color:#2c3e50;&quot;&quot;&gt;&quot;+row(&quot;Volume&quot;).ToString+&quot;&lt;/td&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&lt;/tr&gt;&quot;)&#xA;&#x9;ElseIf CDbl(row(&quot;PercentChange&quot;).ToString.Replace(&quot;%&quot;,&quot;&quot;).Replace(&quot;+&quot;,&quot;&quot;).Trim) &lt;= (-1 * in_threshold)&#xA;&#x9;&#x9;movers.Add(&quot;&lt;span style=&quot;&quot;display:inline-block;padding:4px 10px;border-radius:4px;font-size:13px;font-weight:600;margin:3px 4px 3px 0;background-color:#fdecea;color:#c0392b;&quot;&quot;&gt;&quot;+row(&quot;Ticker&quot;).ToString+&quot; &quot;+row(&quot;PercentChange&quot;).ToString+&quot;&lt;/span&gt;&quot;)&#xA;&#x9;&#x9;tickers.Add(&quot;&lt;tr&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  &lt;td style=&quot;&quot;padding:9px 12px;border-bottom:1px solid #f0f2f5;color:#2c3e50;&quot;&quot;&gt;&quot;+row(&quot;Ticker&quot;).ToString+&quot;&lt;/td&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  &lt;td style=&quot;&quot;padding:9px 12px;border-bottom:1px solid #f0f2f5;color:#2c3e50;&quot;&quot;&gt;&quot;+row(&quot;Open&quot;).ToString+&quot;&lt;/td&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  &lt;td style=&quot;&quot;padding:9px 12px;border-bottom:1px solid #f0f2f5;color:#2c3e50;&quot;&quot;&gt;&quot;+row(&quot;Close&quot;).ToString+&quot;&lt;/td&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  &lt;td style=&quot;&quot;padding:9px 12px;border-bottom:1px solid #f0f2f5;font-weight:600;color:#c0392b;&quot;&quot;&gt;&quot;+row(&quot;PercentChange&quot;).ToString+&quot;&lt;/td&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  &lt;td style=&quot;&quot;padding:9px 12px;border-bottom:1px solid #f0f2f5;color:#2c3e50;&quot;&quot;&gt;&quot;+row(&quot;Volume&quot;).ToString+&quot;&lt;/td&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&lt;/tr&gt;&quot;)&#xA;&#x9;Else&#xA;&#x9;&#x9;tickers.Add(&quot;&lt;tr&gt;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  &lt;td style=&quot;&quot;padding:9px 12px;border-bottom:1px solid #f0f2f5;color:#2c3e50;&quot;&quot;&gt;&quot;+row(&quot;Ticker&quot;)